{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "qestack": {
      "source": {
        "source": "github",
        "repo": "quark-sri/qestack"
      }
    },
    "domainlore": {
      "source": {
        "source": "github",
        "repo": "quark-sri/domainlore"
      }
    }
  },
  "enabledPlugins": {
    "qestack@qestack": true,
    "domainlore@domainlore": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npx bddgen*)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc*)",
      "Bash(node scripts/*)",
      "Bash(uvx --from git+https://github.com/quark-sri/domainlore lore *)",
      "Bash(lore *)",
      "Bash(npx playwright cli *)",
      "Bash(playwright-cli *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.qa)",
      "Read(./.env.staging)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Bash(cat .env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/check-edit.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
