{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "qestack": {
      "source": {
        "source": "github",
        "repo": "quark-sri/qestack"
      }
    },
    "domainlore": {
      "source": {
        "source": "github",
        "repo": "quark-sri/domainlore"
      }
    }
  },
  "enabledPlugins": {
    "qestack@qestack": true,
    "domainlore@domainlore": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run test*)",
      "Bash(npm run check)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck)",
      "Bash(npm run doctor*)",
      "Bash(npm run steps:list)",
      "Bash(npm run report*)",
      "Bash(npm run explore*)",
      "Bash(npm run auth:save*)",
      "Bash(npm run env:set*)",
      "Bash(npm run parked*)",
      "Bash(npm run bddgen)",
      "Bash(npm run guard)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npx bddgen*)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc*)",
      "Bash(node scripts/*)",
      "Bash(uvx --from git+https://github.com/quark-sri/domainlore lore *)",
      "Bash(lore *)",
      "Bash(npx playwright cli *)",
      "Bash(playwright-cli *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.dev)",
      "Read(./.env.test)",
      "Read(./.env.qa)",
      "Read(./.env.uat)",
      "Read(./.env.staging)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./.auth/**)",
      "Bash(cat .env*)",
      "Bash(cat .auth/*)",
      "Bash(head .env*)",
      "Bash(head .auth/*)",
      "Bash(tail .env*)",
      "Bash(tail .auth/*)",
      "Bash(less .env*)",
      "Bash(less .auth/*)",
      "Bash(more .env*)",
      "Bash(more .auth/*)",
      "Bash(bat .env*)",
      "Bash(bat .auth/*)",
      "Bash(strings .env*)",
      "Bash(strings .auth/*)",
      "Bash(grep * .env*)",
      "Bash(grep * .auth/*)",
      "Bash(rg * .env*)",
      "Bash(rg * .auth/*)",
      "Bash(source .env*)",
      "Bash(cp .auth/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/check-edit.mjs",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-protected.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
