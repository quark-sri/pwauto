# ---------------------------------------------------------------------------
# pwauto configuration. Copy this file to .env and change the values.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# .env is never committed. For other environments create .env.qa,
# .env.staging, ... and run with TEST_ENV=qa npm test.
# ---------------------------------------------------------------------------

# --- Application under test -------------------------------------------------
TEST_ENV=local
# The web application you want to test, e.g. https://qa.my-app.example.com
BASE_URL=
# Optional: backend API, for fast data setup (create users, orders, ...)
API_URL=
# The HTML attribute your developers use for test IDs:
# data-testid (React default), data-test, data-qa, data-cy, ...
TEST_ID_ATTRIBUTE=data-testid

# Also run the reference example (examples/toolshop, its own URL and users)
# next to your own tests. While BASE_URL is empty the example runs anyway.
# Run it on demand with `npm run test:example`.
INCLUDE_EXAMPLES=false

# --- Login form of YOUR app (used by "Given I am logged in as a <role>") ---------
# Use the texts you see on screen: field labels/placeholders and the button name.
LOGIN_PATH=/login
LOGIN_USERNAME_FIELD=Email
LOGIN_PASSWORD_FIELD=Password
LOGIN_SUBMIT_BUTTON=Sign in
# URL part (starting with /) or visible text that proves the login worked
LOGIN_SUCCESS=

# --- Test users --------------------------------------------------------------
# One pair per role. A step like "Given I am logged in as a customer" reads
# CUSTOMER_USERNAME and CUSTOMER_PASSWORD. Role "store admin" -> STORE_ADMIN_*.
# Put real credentials only in .env or CI secrets, never in .env.example.
CUSTOMER_USERNAME=
CUSTOMER_PASSWORD=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# --- Browsers and run ---------------------------------------------------------
# Comma list: chromium, firefox, webkit, chrome, msedge, mobile-chrome, mobile-safari
BROWSERS=chromium
HEADLESS=true
# Milliseconds to wait between actions (useful to watch a headed run)
SLOW_MO=0
# Parallel workers: a number or a percentage like 50%. Empty = Playwright default.
WORKERS=
# Retries per failed test. Empty = 2 on CI, 0 locally.
RETRIES=
LOCALE=en-US
TIMEZONE=UTC
VIEWPORT=1366x900

# --- Timeouts (milliseconds) ---------------------------------------------------
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# --- Evidence for reports --------------------------------------------------------
# SCREENSHOT: on | off | only-on-failure
SCREENSHOT=on
# VIDEO / TRACE: on | off | retain-on-failure | on-first-retry
VIDEO=retain-on-failure
TRACE=retain-on-failure
# Keep request/response bodies of failed API calls in network-errors.json
# (secrets are masked). Default: on locally, off on CI (bodies can hold personal data).
CAPTURE_NETWORK_BODIES=
# Screenshot after every Gherkin step (bigger reports, great for demos and debugging)
STEP_SCREENSHOTS=false
# Run an axe accessibility scan on every page a scenario visits (report only)
A11Y_CHECKS=false
# Terminal log level: debug | info | warn | error (the report always has the full log)
LOG_LEVEL=warn
# Fixed seed for generated test data, to reproduce a failing run
DATA_SEED=
