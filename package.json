{
  "name": "pwauto",
  "version": "0.1.0",
  "description": "AI-agent-ready UI test automation scaffold: Playwright + TypeScript + BDD (Gherkin) with Claude Code / Codex agents and skills.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/sync-agent-skills.mjs",
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:regression": "bddgen && playwright test --grep @regression",
    "test:headed": "bddgen && playwright test --headed --project=chromium",
    "test:ui": "bddgen && playwright test --ui",
    "test:debug": "bddgen && playwright test --debug --project=chromium",
    "test:flaky-check": "bddgen && playwright test --repeat-each=5 --retries=0 --workers=4",
    "explore": "node --experimental-strip-types scripts/crawl.ts",
    "report": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results -o reports/allure-report --clean && allure open reports/allure-report",
    "report:cucumber": "node -e \"import('node:child_process').then(c=>c.exec((process.platform==='win32'?'start \\\"\\\" ':process.platform==='darwin'?'open ':'xdg-open ')+'reports/cucumber/report.html'))\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "bddgen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && node scripts/guard-weakening.mjs && npm run test:unit && node scripts/lint-skills.mjs && node scripts/sync-agent-skills.mjs --check",
    "clean": "node -e \"for (const d of ['reports','test-results','.features-gen']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "test:app": "bddgen && playwright test --project='app-*'",
    "steps:list": "bddgen export",
    "example:remove": "node scripts/remove-example.mjs",
    "trace": "playwright show-trace",
    "env:set": "node scripts/env-set.mjs",
    "auth:save": "node --experimental-strip-types scripts/auth-save.ts",
    "agents:update": "playwright init-skills && node -e \"require('node:fs').rmSync('.claude/skills/playwright-component-testing',{recursive:true,force:true})\" && node scripts/sync-agent-skills.mjs",
    "test:example": "node scripts/run-example.mjs",
    "guard": "node scripts/guard-weakening.mjs",
    "test:unit": "playwright test -c tests/unit",
    "lint:skills": "node scripts/lint-skills.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  }
}
